{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user profile and core identity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar_url": { "type": "string", "maxLength": 500 },
        "headline": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "enum": ["New Seller", "Level 1", "Level 2", "Top Rated Seller", "Pro Studio"] },
        "rating": { "type": "number" },
        "reviews_count": { "type": "number" },
        "response_time": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "joined_date": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["buyer", "seller", "admin"] },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "role"]
    },
    "BuyerProfile": {
      "title": "BuyerProfile",
      "description": "Private and preference details for music clients/buyers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar_url": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 1000 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "buyer_type": { "type": "string", "enum": ["individual", "business"] },
        "is_verified": { "type": "boolean" },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "user_id"]
    },
    "SellerProfile": {
      "title": "SellerProfile",
      "description": "Public studio audio engineer / music producer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "headline": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 2000 },
        "level": { "type": "string", "maxLength": 50 },
        "rating": { "type": "number" },
        "reviews_count": { "type": "number" },
        "is_verified": { "type": "boolean" },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "user_id", "name"]
    },
    "Gig": {
      "title": "Gig",
      "description": "Marketplace audio gig catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seller_id": { "type": "string", "maxLength": 128 },
        "service_id": { "type": "string", "maxLength": 100 },
        "service_type": { "type": "string", "maxLength": 100 },
        "title_prefix": { "type": "string", "maxLength": 20 },
        "service_title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "published", "paused", "pending_review"] },
        "has_three_packages": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 5000 },
        "published_at": { "type": "string", "maxLength": 50 },
        "created_at": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "seller_id", "service_id", "service_title", "status"]
    },
    "GigPackage": {
      "title": "GigPackage",
      "description": "Tiered pricing package belonging to a Gig (Basic, Standard, Premium)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "gig_id": { "type": "string", "maxLength": 128 },
        "package_type": { "type": "string", "enum": ["basic", "standard", "premium"] },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "price_inr": { "type": "number" },
        "delivery_days": { "type": "number" },
        "revisions": { "type": "number" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "gig_id", "package_type", "price_inr", "delivery_days"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Master user profiles keyed by auth UID"
    },
    "/buyerProfiles/{userId}": {
      "schema": "#/entities/BuyerProfile",
      "description": "Private buyer settings, language, location and order preferences keyed by auth UID"
    },
    "/sellerProfiles/{sellerId}": {
      "schema": "#/entities/SellerProfile",
      "description": "Seller studio profile, gear, and badges keyed by auth UID"
    },
    "/gigs/{gigId}": {
      "schema": "#/entities/Gig",
      "description": "Marketplace audio engineering and production gigs"
    },
    "/gigPackages/{packageId}": {
      "schema": "#/entities/GigPackage",
      "description": "Gig tier packages linked to parent Gig document"
    }
  }
}
